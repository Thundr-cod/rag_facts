# macOS filesystem cruft — keep out of the repo
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100

# Per-PC model pick written by the facts launcher (names the computer)
.system/.model-choice-*

# NOTE: .metadata_never_index is INTENTIONAL — it ships on the drive to tell
# macOS Spotlight not to index the volume. Do NOT ignore it.

# facts launcher build output (attached to releases, not committed)
facts-rs/target/
.system/facts-windows.exe
.system/facts-macos
.system/facts-linux

# User documents and the RAG index built from them (personal; never commit)
data/
.system/rag/
.system/embed/*.gguf
